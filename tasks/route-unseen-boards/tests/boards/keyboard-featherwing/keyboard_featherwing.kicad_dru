(version 1)
# Minimum track widths, net by net: no track may be narrower than the narrowest track the
# board's designer used on that net. Net names are spelled as in the board file.
(rule "tracks at least 0.25 mm wide (64 nets)"
  (condition "A.NetName == '+5V' || A.NetName == '+BATT' || A.NetName == '/A0' || A.NetName == '/A1' || A.NetName == '/A2' || A.NetName == '/A3' || A.NetName == '/A4' || A.NetName == '/A5' || A.NetName == '/ALS' || A.NetName == '/AREF' || A.NetName == '/CARD_CIPO' || A.NetName == '/CARD_CLK' || A.NetName == '/CARD_COPI' || A.NetName == '/CARD_CS' || A.NetName == '/CARD_DET' || A.NetName == '/EN' || A.NetName == '/GPIO10' || A.NetName == '/GPIO11' || A.NetName == '/GPIO12' || A.NetName == '/GPIO13' || A.NetName == '/GPIO5' || A.NetName == '/GPIO6' || A.NetName == '/GPIO9' || A.NetName == '/KBD_INT' || A.NetName == '/KBD_RESET' || A.NetName == '/KBD_SCL' || A.NetName == '/KBD_SDA' || A.NetName == '/Keyboard/BTN_LEFT1' || A.NetName == '/Keyboard/BTN_LEFT2' || A.NetName == '/Keyboard/BTN_RIGHT1' || A.NetName == '/Keyboard/BTN_RIGHT2' || A.NetName == '/Keyboard/JOY_CENTER' || A.NetName == '/Keyboard/JOY_DOWN' || A.NetName == '/Keyboard/JOY_LEFT' || A.NetName == '/Keyboard/JOY_RIGHT' || A.NetName == '/Keyboard/JOY_UP' || A.NetName == '/LCD_BL_CTRL' || A.NetName == '/LCD_CS' || A.NetName == '/LCD_DC' || A.NetName == '/NEOPIXEL' || A.NetName == '/RX' || A.NetName == '/TP_INT' || A.NetName == '/TP_XM' || A.NetName == '/TP_XP' || A.NetName == '/TP_YM' || A.NetName == '/TP_YP' || A.NetName == '/TX' || A.NetName == 'GND' || A.NetName == 'Net-(C3-Pad1)' || A.NetName == 'Net-(D1-Pad2)' || A.NetName == 'Net-(D1-Pad4)' || A.NetName == 'Net-(D2-Pad1)' || A.NetName == 'Net-(Q2-Pad3)' || A.NetName == 'Net-(R5-Pad2)' || A.NetName == 'Net-(R7-Pad1)' || A.NetName == 'Net-(TP11-Pad1)' || A.NetName == 'Net-(TP12-Pad1)' || A.NetName == 'Net-(TP13-Pad1)' || A.NetName == 'Net-(TP14-Pad1)' || A.NetName == 'Net-(TP3-Pad1)' || A.NetName == 'Net-(TP4-Pad1)' || A.NetName == 'Net-(TP8-Pad1)' || A.NetName == 'VBUS' || A.NetName == 'unconnected-(U6-Pad16)'")
  (constraint track_width (min 0.25mm)))
