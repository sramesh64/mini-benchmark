(version 1)
# Minimum track widths, net by net: no track may be narrower than the narrowest track the
# board's designer used on that net. Net names are spelled as in the board file.
(rule "tracks at least 0.3 mm wide (3 nets)"
  (condition "A.NetName == '/PC-A6' || A.NetName == '/PC-A7' || A.NetName == '/PC-A8'")
  (constraint track_width (min 0.3mm)))
(rule "tracks at least 0.381 mm wide (3 nets)"
  (condition "A.NetName == '/LED2' || A.NetName == 'GND' || A.NetName == 'Net-(D2-A)'")
  (constraint track_width (min 0.381mm)))
(rule "tracks at least 0.4 mm wide (5 nets)"
  (condition "A.NetName == '/BIT7' || A.NetName == '/PC-A9' || A.NetName == '/PC-AEN' || A.NetName == '/SLCTIN-' || A.NetName == 'VCC'")
  (constraint track_width (min 0.4mm)))
(rule "tracks at least 0.4318 mm wide (99 nets)"
  (condition "A.NetName == '/8MH-OUT' || A.NetName == '/ACK' || A.NetName == '/AUTOFD-' || A.NetName == '/BIT0' || A.NetName == '/BIT1' || A.NetName == '/BIT2' || A.NetName == '/BIT3' || A.NetName == '/BIT4' || A.NetName == '/BIT5' || A.NetName == '/BIT6' || A.NetName == '/BUST+' || A.NetName == '/CLKLCA' || A.NetName == '/CS1-' || A.NetName == '/D0' || A.NetName == '/D1' || A.NetName == '/D2' || A.NetName == '/D3' || A.NetName == '/D4' || A.NetName == '/D5' || A.NetName == '/D6' || A.NetName == '/D7' || A.NetName == '/DIR' || A.NetName == '/DONE' || A.NetName == '/ENBBUF' || A.NetName == '/ERROR-' || A.NetName == '/INIT-' || A.NetName == '/LED1' || A.NetName == '/MA0' || A.NetName == '/MA1' || A.NetName == '/MA10' || A.NetName == '/MA11' || A.NetName == '/MA12' || A.NetName == '/MA13' || A.NetName == '/MA14' || A.NetName == '/MA15' || A.NetName == '/MA16' || A.NetName == '/MA2' || A.NetName == '/MA3' || A.NetName == '/MA4' || A.NetName == '/MA5' || A.NetName == '/MA6' || A.NetName == '/MA7' || A.NetName == '/MA8' || A.NetName == '/MA9' || A.NetName == '/MATCHL' || A.NetName == '/MD0' || A.NetName == '/MD1' || A.NetName == '/MD2' || A.NetName == '/MD3' || A.NetName == '/MD4' || A.NetName == '/MD5' || A.NetName == '/MD6' || A.NetName == '/MD7' || A.NetName == '/OE-' || A.NetName == '/PC-A0' || A.NetName == '/PC-A1' || A.NetName == '/PC-A10' || A.NetName == '/PC-A11' || A.NetName == '/PC-A2' || A.NetName == '/PC-A3' || A.NetName == '/PC-A4' || A.NetName == '/PC-A5' || A.NetName == '/PC-DB0' || A.NetName == '/PC-DB1' || A.NetName == '/PC-DB2' || A.NetName == '/PC-DB3' || A.NetName == '/PC-DB4' || A.NetName == '/PC-DB5' || A.NetName == '/PC-DB6' || A.NetName == '/PC-DB7' || A.NetName == '/PC-IOR' || A.NetName == '/PC-IOW' || A.NetName == '/PC-RD' || A.NetName == '/PC-RST' || A.NetName == '/PC-WR' || A.NetName == '/PE+' || A.NetName == '/PROG-' || A.NetName == '/REF10' || A.NetName == '/REF11' || A.NetName == '/REF4' || A.NetName == '/REF5' || A.NetName == '/REF6' || A.NetName == '/REF7' || A.NetName == '/REF8' || A.NetName == '/REF9' || A.NetName == '/RSTL' || A.NetName == '/SEL_LPT' || A.NetName == '/SLCT+' || A.NetName == '/STROBE' || A.NetName == '/WR-' || A.NetName == '/WR_REG' || A.NetName == 'Net-(C3-Pad1)' || A.NetName == 'Net-(D1-A)' || A.NetName == 'Net-(U3-Y0)' || A.NetName == 'Net-(U3-Y1)' || A.NetName == 'Net-(U3-Y2)' || A.NetName == 'Net-(U3-Y3)' || A.NetName == 'Net-(U5-CS2)' || A.NetName == 'Net-(U9-P{slash}A3)'")
  (constraint track_width (min 0.4318mm)))
